---
import BaseLayout from "../layouts/BaseLayout.astro";
import Writing from "../components/Writing.astro";
import { getWritings } from '../lib/writings';
import Link from '../components/Link.astro';
import { formatDate } from "../lib/formatDate";
import border_color from '../components/Link.astro';


let posts = await Astro.glob<PostFrontmatter>("../../posts/**/*.mdx");
const writings =  await getWritings();
const title = "Max Twelftree";
const description = "Machine learning engineer/research scientist — inference, post-training, GPUs";

if (import.meta.env.PROD) {
  posts = posts.filter((post) => !post.frontmatter.draft);
}

posts.sort((a, b) => {
  return (
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
  );
});

---

<BaseLayout title={title} description={description}>
  <h1 slot="header-content" class="text-gray-600 dark:text-gray-500 mt-2"><Link href="/">Max Twelftree</Link></h1>
  <main class="py-10 zaduma-prose">
    <p class="text-gray-600 dark:text-gray-500 mb-2" style="font-size: 12px;"> ◕ ◡ ◕ っ </p>
    <p>
      Hey, I'm <strong>Max!</strong> I'm a machine learning engineer/research scientist at <Link href="https://maincode.com">Maincode</Link> 🇦🇺.
      I graduated from the <strong>University of Adelaide</strong> with a Bachelors degree in Mathematics and Computer Science, where I focused on machine learning and philosophy.
    </p>
    <p>
      I love inference, post-training, and GPUs. Reach out to me via <Link href="mailto:max@maincode.com">max@maincode.com</Link>.
    </p>

    <hr class="border_color">

    <h2 style="font-size: 18px; font-weight: bold;"><Link href="/travels">Travels</Link></h2>
    <p class="text-gray-500 dark:text-gray-400 text-sm" style="margin-bottom: 0.5rem;">Photos from some of the places I've been to recently.</p>
    <div class="travels-list">
      <span>🇪🇬</span><span>🇯🇴</span><span>🇲🇳</span><span>🇴🇲</span><span>🇹🇼</span><span>🇯🇵</span><span>🇺🇸</span><span>🇻🇳</span><span>🇹🇭</span>
    </div>

    <hr class="border_color" style="margin-top: 2rem;">

    <h2 style="font-size: 18px; font-weight: bold;">Writing</h2>
    <ul>
      {posts.map(({ frontmatter }) => {
        const date = new Date(frontmatter.date);

        return (
          <li class="flex justify-between items-center">
            <Link
              href={frontmatter.path}
              class="flex-grow"
              noUnderline
            >
              <h2 class="text-gray-800 dark:text-gray-300 font-sans mb-4">
                {frontmatter.title}
              </h2>
            </Link>
            <time
              datetime={date.toISOString()}
              class="text-gray-600 dark:text-gray-400 tabular-nums tracking-tighter"
            >
              {formatDate(date)}
            </time>
          </li>
        );
      })
    }
    </ul>

    <hr class="border_color">

    <footer>
      <div class="name-container">
        <span>Max Twelftree</span>
      </div>
      <div class="icons-container">
        <a href="mailto:maxjtwelftree@gmail.com" aria-label="Email">
          <i class="fas fa-envelope"></i>
        </a>
        <a href="https://x.com/mxwellllll" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
          <i class="fab fa-twitter"></i>
        </a>
        <a href="https://github.com/maxjtwelftree" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <i class="fab fa-github"></i>
        </a>
        <a href="https://www.linkedin.com/in/maxjtwelftree/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <i class="fab fa-linkedin"></i>
        </a>
      </div>
    </footer>
  </main>
<style>
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0;
  }

  footer .name-container {
    margin-left: 0px;
  }

  footer .icons-container {
    display: flex;
    gap: 20px;
    margin-right: 0px;
  }

  footer a {
    margin: 0;
    color: inherit;
  }

  footer a i {
    font-size: 24px;
  }

  .travels-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 1.4rem;
  }
</style>
