---
import BaseLayout from "../layouts/BaseLayout.astro";
import Project from "../components/Project.astro";
import Writing from "../components/Writing.astro";
import Experience from "../components/Experience.astro";
import { getProjects } from '../lib/projects';
import { getWritings } from '../lib/writings';
import { getExperience } from '../lib/experience';
import Link from '../components/Link.astro';
import { Paragraph } from "../lib/prose/Paragraph";
import { formatDate } from "../lib/formatDate";
import border_color from '../components/Link.astro';


let posts = await Astro.glob<PostFrontmatter>("../../posts/**/*.mdx");
const projects = await getProjects();
const writings =  await getWritings();
const experience = await getExperience();
const title = "Max Twelftree";
const description = "My small website for projects, experience and further information";

if (import.meta.env.PROD) {
  posts = posts.filter((post) => !post.frontmatter.draft);
}

posts.sort((a, b) => {
  return (
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
  );
});

---

<BaseLayout title={title} description={description}>
<h1 slot="header-content" class="text-gray-600 dark:text-gray-500 mt-2"><Link href="/">Max Twelftree</Link></h1>
  <main class="py-10 zaduma-prose">
    <p class="text-gray-600 dark:text-gray-500 mb-2" style="font-size: 12px;"> ◕ ◡ ◕ っ </p>
    <p>
      Hey, I’m <strong>Max!</strong> I'm currently a software engineer based in Australia 🇦🇺. Recently I completed a <i>Bachelors degree in Mathematics and Computer Science</i> from the <strong>University of Adelaide</strong>. I have a strong passion for new technologies particularly those in machine learning infrastructure, as well as design and its relationship to software engineering.
    </p>
    <p>
    Besides software, I enjoy <em><Link href="/travels" style="italic">travelling,</Link></em> fitness, religion, philosophy, geo-politics, and other parts of design. Please <strong>reach out</strong> if you're interested in collaborating or just want to talk.
    <br>
    </p>

    <hr class="border_color">

    <h2 style="font-size: 18px; font-weight: bold;">Experience</h2>
    <div class="divide-y divide-gray-200 dark:divide-gray-800">
      {experience.map(exp => <Experience experience={exp} />)}
    </div>

    <hr class="border_color">

    <h2 style="font-size: 18px; font-weight: bold;">Projects</h2>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
      {projects.map(project => <Project project={project} />)}
    </div>

    <hr class="border_color">

    <h2 style="font-size: 18px; font-weight: bold;"><Link href="/travels">Travels</Link></h2>
    <p class="text-gray-500 dark:text-gray-400 text-sm" style="margin-bottom: 0.5rem;">Photos from some of the places I've been to recently.</p>
    <div class="travels-list">
      <span>🇪🇬</span><span>🇯🇴</span><span>🇲🇳</span><span>🇴🇲</span><span>🇹🇼</span><span>🇯🇵</span><span>🇺🇸</span><span>🇻🇳</span><span>🇹🇭</span>
    </div>

    <hr class="border_color" style="margin-top: 2rem;">

    <h2 style="font-size: 18px; font-weight: bold;">Writing</h2>
    <ul>
      {posts.map(({ frontmatter }) => {
        const date = new Date(frontmatter.date);

        return (
          <li class="flex justify-between items-center">
            <Link
              href={frontmatter.path}
              class="flex-grow"
              noUnderline
            >
              <h2 class="text-gray-800 dark:text-gray-300 font-sans mb-4">
                {frontmatter.title}
              </h2>
            </Link>
            <time
              datetime={date.toISOString()}
              class="text-gray-600 dark:text-gray-400 tabular-nums tracking-tighter"
            >
              {formatDate(date)}
            </time>
          </li>
        );
      })
    }
    </ul>

    <hr class="border_color">

      <footer>
        <div class="name-container">
          <span>Max Twelftree</span>
        </div>
        <div class="icons-container">
          <a href="mailto:maxjtwelftree@gmail.com" aria-label="Email">
            <i class="fas fa-envelope"></i>
          </a>
          <a href="https://github.com/maxjtwelftree" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <i class="fab fa-github"></i>
          </a>
          <a href="https://www.linkedin.com/in/maxjtwelftree/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <i class="fab fa-linkedin"></i>
          </a>
          <a href="https://twitter.com/mxwelllllll" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
            <i class="fab fa-twitter"></i>
          </a>
        </div>
      </footer>
  </main>
<style>
footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0; /* Remove padding to align with the footer line */
}

footer .name-container {
  margin-left: 0px; /* Add margin to the left of the name */
}

footer .icons-container {
  display: flex;
  gap: 20px;
  margin-right: 0px; /* Add margin to the right of the icons */
}

footer a {
  margin: 0; /* Reset any default margins */
  color: inherit; /* Inherit text color from parent, or set a specific color */
}

footer a i {
  font-size: 24px; /* Adjust the icon size as needed */
}

.travels-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  font-size: 1.4rem;
}
